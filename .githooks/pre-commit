#!/usr/bin/env bash
# Fast pre-commit gate: comment language, file size, format and clippy.
#
# These finish in milliseconds to seconds. cargo test is an order of magnitude
# slower (seven test binaries to link) and belongs in scripts/build.sh --gate
# and CI, not in a hook that people would bypass with --no-verify.
#
# No MSVC environment is needed: fmt only reads sources and clippy runs cargo
# check (no linking), so scripts/env.sh is deliberately not sourced.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
#
# Skip:
#   SKIP_GATE=1 git commit ...     # explicit opt-out, the hook prints a line
#   git commit --no-verify ...     # git's native escape hatch

set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

if [ "${SKIP_GATE:-0}" = "1" ]; then
    echo "[pre-commit] SKIP_GATE=1，跳过门禁"
    exit 0
fi

# The staged files, not the working tree, decide whether a commit needs a build.
changed="$(git diff --cached --name-only --diff-filter=ACMR)"
if ! printf '%s\n' "$changed" | grep -qE '(\.rs$|Cargo\.toml$|Cargo\.lock$|rust-toolchain\.toml$)'; then
    exit 0
fi

fail=0

echo "[pre-commit] comment + file size gates"
if ! ./scripts/check-comments.sh --self-test >/dev/null || ! ./scripts/check-comments.sh; then
    echo "  x comment gate failed; see CONTRIBUTING.md section 6." >&2
    fail=1
fi
if ! ./scripts/check-size.sh --self-test >/dev/null || ! ./scripts/check-size.sh; then
    echo "  x file size gate failed; see CONTRIBUTING.md section 7." >&2
    fail=1
fi

echo "[pre-commit] cargo fmt --all --check"
if ! cargo fmt --all --check; then
    echo
    echo "  ✗ 格式不符合 rustfmt。修法：cargo fmt --all" >&2
    fail=1
fi

echo "[pre-commit] cargo clippy -D warnings"
if ! cargo clippy --workspace --all-targets --quiet -- -D warnings; then
    echo
    echo "  ✗ clippy 有告警（本项目把 warning 当 error）。" >&2
    fail=1
fi

if [ "$fail" -ne 0 ]; then
    echo
    echo "提交被拦下。确认要提交这份状态时用：git commit --no-verify" >&2
    exit 1
fi

exit 0
